# ===== Server =====
PORT=3001
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ===== PostgreSQL (thestemeducator database) =====
# Either set DATABASE_URL, or the individual PG* vars below.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thestemeducator
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=thestemeducator

# ===== JWT =====
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ===== White-label / Instance =====
# Unique ID for this customer deployment (used in audit logs)
INSTANCE_ID=change-me-to-a-unique-customer-id
# Display name for this deployment (shown in UI)
APP_NAME=The STEM Educator
COMPANY_NAME=Your Company

# ===== White-label DNS (CNAME target) =====
# Canonical host that tenant custom domains CNAME to.
# Overridable per-tenant via the `cnameTarget` field in the register/create forms.
# Defaults to the BACKEND_URL hostname if unset.
PLATFORM_HOST=localhost

# ===== Initial Super Admin (used by setup-db.bat on first run) =====
ADMIN_EMAIL=admin@thestemeducator.com
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=superadmin

# ===== Google SSO (https://console.cloud.google.com) =====
# Authorized redirect URI: {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Microsoft SSO (https://portal.azure.com App registrations) =====
# Redirect URI: {BACKEND_URL}/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
